<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Amadioha Cyber Defense — Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root {
            --primary: #0d6efd;
            --danger: #dc3545;
            --warning: #ffc107;
            --success: #198754;
            --dark: #212529;
            --light: #f8f9fa;
        }
        
        body {
            background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .navbar {
            background: rgba(13, 27, 42, 0.95) !important;
            backdrop-filter: blur(10px);
            border-bottom: 2px solid #0d6efd;
        }
        
        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
            color: #00d4ff !important;
        }
        
        .container-fluid {
            padding: 20px;
        }
        
        .dashboard-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
            border: none;
            margin-bottom: 20px;
            transition: all 0.3s ease;
        }
        
        .dashboard-card:hover {
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
            transform: translateY(-4px);
        }
        
        .card-header {
            background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%);
            color: white;
            border: none;
            border-radius: 12px 12px 0 0 !important;
            padding: 20px;
            font-weight: 600;
        }
        
        .card-body {
            padding: 20px;
        }
        
        .input-group {
            margin-bottom: 15px;
        }
        
        .form-control, .form-select {
            border: 2px solid #e9ecef;
            border-radius: 8px;
            padding: 10px 15px;
            transition: all 0.3s ease;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }
        
        .btn {
            border-radius: 8px;
            padding: 10px 20px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%);
            border: none;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 16px rgba(13, 110, 253, 0.4);
        }
        
        .loading {
            display: none;
        }
        
        .spinner-border {
            color: #0d6efd;
        }
        
        .badge {
            padding: 8px 12px;
            border-radius: 20px;
            font-size: 0.9rem;
        }
        
        .badge-critical { background-color: #dc3545; }
        .badge-high { background-color: #fd7e14; }
        .badge-medium { background-color: #ffc107; color: #000; }
        .badge-low { background-color: #198754; }
        
        .results-table {
            font-size: 0.95rem;
        }
        
        .results-table thead {
            background: #f8f9fa;
            border-bottom: 2px solid #dee2e6;
        }
        
        .results-table tbody tr:hover {
            background-color: #f8f9fa;
        }
        
        .stats-box {
            background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%);
            color: white;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            margin-bottom: 15px;
        }
        
        .stats-number {
            font-size: 2.5rem;
            font-weight: 700;
        }
        
        .stats-label {
            font-size: 0.95rem;
            opacity: 0.9;
        }
        
        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: #6c757d;
        }
        
        .empty-state-icon {
            font-size: 3rem;
            margin-bottom: 15px;
            opacity: 0.5;
        }
        
        .alert {
            border-radius: 8px;
            border: none;
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-dark sticky-top">
        <div class="container-fluid">
            <span class="navbar-brand">
                <i class="bi bi-shield-check"></i> Amadioha Cyber Defense
            </span>
            <span class="navbar-text" style="color: #0dcaf0;">v0.2.0 — Web Dashboard</span>
        </div>
    </nav>

    <div class="container-fluid">
        <!-- Alert Messages -->
        <div id="alertContainer"></div>

        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <h1 class="text-white fw-bold mb-2">Security Operations Center</h1>
                <p class="text-white-50">Scan networks, analyze logs, and investigate threats in real-time</p>
            </div>
        </div>

        <div class="row">
            <!-- Network Scanner -->
            <div class="col-lg-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="card-header">
                        <i class="bi bi-wifi"></i> Network Scanner
                    </div>
                    <div class="card-body">
                        <form id="scanForm">
                            <div class="input-group">
                                <label class="form-label">Target IP</label>
                                <input type="text" class="form-control" id="scanTarget" placeholder="192.168.1.1" value="127.0.0.1">
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <div class="input-group">
                                        <label class="form-label">Start Port</label>
                                        <input type="number" class="form-control" id="scanStart" value="1" min="1" max="65535">
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="input-group">
                                        <label class="form-label">End Port</label>
                                        <input type="number" class="form-control" id="scanEnd" value="1024" min="1" max="65535">
                                    </div>
                                </div>
                            </div>
                            <div class="input-group">
                                <label class="form-label">Profile</label>
                                <select class="form-select" id="scanProfile">
                                    <option value="safe">Safe (20 workers, slow)</option>
                                    <option value="balanced" selected>Balanced (50 workers)</option>
                                    <option value="fast">Fast (200 workers, aggressive)</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary w-100" id="scanBtn">
                                <i class="bi bi-play-fill"></i> Start Scan
                            </button>
                        </form>
                        <div class="loading" id="scanLoading">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Scanning ports...</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Log Analyzer -->
            <div class="col-lg-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="card-header">
                        <i class="bi bi-file-text"></i> Log Analyzer
                    </div>
                    <div class="card-body">
                        <form id="analyzeForm">
                            <div class="input-group">
                                <label class="form-label">Log File Path</label>
                                <input type="text" class="form-control" id="logFile" placeholder="sample_auth.log" value="sample_auth.log">
                            </div>
                            <small class="text-muted d-block mb-3">
                                Linux/WSL: /var/log/auth.log<br>
                                Windows: sample_auth.log (or custom path)
                            </small>
                            <button type="submit" class="btn btn-primary w-100" id="analyzeBtn">
                                <i class="bi bi-play-fill"></i> Analyze Logs
                            </button>
                        </form>
                        <div class="loading" id="analyzeLoading">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Analyzing logs...</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Threat Intel Lookup -->
            <div class="col-lg-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="card-header">
                        <i class="bi bi-exclamation-triangle"></i> Threat Intelligence
                    </div>
                    <div class="card-body">
                        <form id="intelForm">
                            <div class="input-group">
                                <label class="form-label">IP Address to Lookup</label>
                                <input type="text" class="form-control" id="intelIP" placeholder="185.220.101.1" value="185.220.101.1">
                            </div>
                            <button type="submit" class="btn btn-primary w-100" id="intelBtn">
                                <i class="bi bi-play-fill"></i> Lookup Threat
                            </button>
                        </form>
                        <div class="loading" id="intelLoading">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Looking up IP...</p>
                        </div>
                        <div id="intelResult"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Results Section -->
        <div class="row mt-4">
            <!-- Scan Results -->
            <div class="col-12">
                <div class="dashboard-card">
                    <div class="card-header">
                        <i class="bi bi-table"></i> Scan Results
                    </div>
                    <div class="card-body">
                        <div id="scanResults" class="empty-state">
                            <div class="empty-state-icon"><i class="bi bi-inbox"></i></div>
                            <p>No scans yet. Run a network scan to see results here.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Analysis Results -->
            <div class="col-12">
                <div class="dashboard-card">
                    <div class="card-header">
                        <i class="bi bi-list-check"></i> Log Analysis Results
                    </div>
                    <div class="card-body">
                        <div id="analysisResults" class="empty-state">
                            <div class="empty-state-icon"><i class="bi bi-inbox"></i></div>
                            <p>No analyses yet. Analyze a log file to see results here.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const apiBase = '/api';

        // Utility functions
        function showAlert(message, type = 'danger') {
            const alertId = 'alert-' + Date.now();
            const alertHTML = `
                <div id="${alertId}" class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            document.getElementById('alertContainer').insertAdjacentHTML('beforeend', alertHTML);
            setTimeout(() => {
                const el = document.getElementById(alertId);
                if (el) el.remove();
            }, 5000);
        }

        function getRiskBadge(score) {
            if (score > 80) return `<span class="badge badge-critical">🔴 CRITICAL</span>`;
            if (score > 60) return `<span class="badge badge-high">🟠 HIGH</span>`;
            if (score > 40) return `<span class="badge badge-medium">🟡 MEDIUM</span>`;
            return `<span class="badge badge-low">🟢 LOW</span>`;
        }

        // Network Scan
        document.getElementById('scanForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const target = document.getElementById('scanTarget').value;
            const start = document.getElementById('scanStart').value;
            const end = document.getElementById('scanEnd').value;
            const profile = document.getElementById('scanProfile').value;

            document.getElementById('scanLoading').style.display = 'block';
            document.getElementById('scanBtn').disabled = true;

            try {
                const response = await fetch(`${apiBase}/scan`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ target, start, end, profile })
                });
                const data = await response.json();

                if (response.ok) {
                    displayScanResults(data);
                    showAlert(`Scan completed! Found ${data.open_ports.length} open ports.`, 'success');
                } else {
                    showAlert(data.error || 'Scan failed');
                }
            } catch (err) {
                showAlert(`Error: ${err.message}`);
            } finally {
                document.getElementById('scanLoading').style.display = 'none';
                document.getElementById('scanBtn').disabled = false;
            }
        });

        function displayScanResults(result) {
            let html = `
                <div class="stats-box mb-3">
                    <div class="stats-number">${result.open_ports.length}</div>
                    <div class="stats-label">Open Ports Found</div>
                </div>
                <p><strong>Target:</strong> ${result.target}</p>
                <p><strong>Port Range:</strong> ${result.start}–${result.end}</p>
                <p><strong>Profile:</strong> ${result.profile}</p>
            `;

            if (result.open_ports.length > 0) {
                html += `<p><strong>Ports:</strong> ${result.open_ports.join(', ')}</p>`;
            } else {
                html += `<p class="text-muted">No open ports found in this range.</p>`;
            }

            document.getElementById('scanResults').innerHTML = html;
        }

        // Log Analysis
        document.getElementById('analyzeForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const log_file = document.getElementById('logFile').value;

            document.getElementById('analyzeLoading').style.display = 'block';
            document.getElementById('analyzeBtn').disabled = true;

            try {
                const response = await fetch(`${apiBase}/analyze`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ log_file })
                });
                const data = await response.json();

                if (response.ok) {
                    displayAnalysisResults(data);
                    showAlert(`Analysis complete! Found ${data.total_ips} attacking IPs.`, 'success');
                } else {
                    showAlert(data.error || 'Analysis failed');
                }
            } catch (err) {
                showAlert(`Error: ${err.message}`);
            } finally {
                document.getElementById('analyzeLoading').style.display = 'none';
                document.getElementById('analyzeBtn').disabled = false;
            }
        });

        function displayAnalysisResults(result) {
            let html = `
                <div class="stats-box mb-3">
                    <div class="stats-number">${result.total_ips}</div>
                    <div class="stats-label">Attacking IPs Detected</div>
                </div>
                <table class="table table-hover results-table">
                    <thead>
                        <tr>
                            <th>IP Address</th>
                            <th>Attempts</th>
                            <th>Risk Level</th>
                            <th>Threat Type</th>
                        </tr>
                    </thead>
                    <tbody>
            `;

            result.threats.forEach(threat => {
                html += `
                    <tr>
                        <td><code>${threat.ip}</code></td>
                        <td><strong>${threat.attempts}</strong></td>
                        <td>${getRiskBadge(threat.reputation_score)}</td>
                        <td>${threat.threat_type}</td>
                    </tr>
                `;
            });

            html += `
                    </tbody>
                </table>
            `;

            document.getElementById('analysisResults').innerHTML = html;
        }

        // Threat Intelligence
        document.getElementById('intelForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const ip = document.getElementById('intelIP').value;

            document.getElementById('intelLoading').style.display = 'block';
            document.getElementById('intelBtn').disabled = true;

            try {
                const response = await fetch(`${apiBase}/intel`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ip })
                });
                const data = await response.json();

                if (response.ok) {
                    displayIntelResult(data);
                } else {
                    showAlert(data.error || 'Lookup failed');
                }
            } catch (err) {
                showAlert(`Error: ${err.message}`);
            } finally {
                document.getElementById('intelLoading').style.display = 'none';
                document.getElementById('intelBtn').disabled = false;
            }
        });

        function displayIntelResult(data) {
            const html = `
                <div class="mt-3" style="border-top: 2px solid #dee2e6; padding-top: 15px;">
                    <p><strong>IP:</strong> ${data.ip}</p>
                    <p><strong>Risk Level:</strong> ${data.risk_level}</p>
                    <p><strong>Reputation Score:</strong> ${data.reputation_score}/100</p>
                    <p><strong>Threat Type:</strong> ${data.threat_type}</p>
                    <p><strong>Abuse Reports:</strong> ${data.abuse_reports}</p>
                    <p><strong>Known for Attacks:</strong> ${data.known_for_attacks ? '✓ Yes' : '✗ No'}</p>
                    <p><strong>Confidence:</strong> ${(data.confidence * 100).toFixed(0)}%</p>
                </div>
            `;
            document.getElementById('intelResult').innerHTML = html;
        }
    </script>
</body>
</html>
