# Amadioha Cyber Defense — Environment Configuration
# Copy this file to .env and set your values

# Flask Configuration
FLASK_ENV=production
FLASK_APP=amadioha.web:app
SECRET_KEY=your-secret-key-here-change-this-in-production

# Server Configuration
PORT=5000
HOST=0.0.0.0
WORKERS=4
DEBUG=False

# Database (optional, for production)
# DATABASE_URL=postgresql://user:password@localhost/amadioha_db

# Logging
LOG_LEVEL=INFO

# Rate Limiting (optional)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_PERIOD=3600

# Threat Intelligence API Keys (optional, for real API integration)
# ABUSEIPDB_API_KEY=your-api-key
# VIRUSTOTAL_API_KEY=your-api-key
# ALIENVAULT_API_KEY=your-api-key
